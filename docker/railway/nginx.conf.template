# Rendered by docker/railway/entrypoint.sh (envsubst) into /etc/nginx/nginx.conf.
# Substituted: ${PORT} ${SITE_NAME} ${SITE_URL} ${ROOT_LOCATION} ${CLIENT_MAX_BODY_SIZE}

user frappe;
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /dev/stdout;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    client_body_temp_path /tmp/nginx/client_body;
    proxy_temp_path /tmp/nginx/proxy;
    fastcgi_temp_path /tmp/nginx/fastcgi;
    uwsgi_temp_path /tmp/nginx/uwsgi;
    scgi_temp_path /tmp/nginx/scgi;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/wasm
        application/xml
        image/svg+xml
        text/css
        text/plain
        text/xml;

    # Railway terminates TLS at the edge, so trust its forwarded scheme.
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    upstream frappe-backend {
        server 127.0.0.1:8000 fail_timeout=0;
    }

    upstream frappe-socketio {
        server 127.0.0.1:9000 fail_timeout=0;
    }

    server {
        listen ${PORT} default_server;
        listen [::]:${PORT} default_server;
        server_name _;

        root /home/frappe/frappe-bench/sites;

        # Railway terminates TLS and forwards to $PORT, so nginx must never put
        # its own scheme/port into a Location header.
        absolute_redirect off;
        port_in_redirect off;

        # Built app bundles: /assets/helpdesk/desk/..., /assets/frappe/dist/...
        location /assets {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        # Private files, served through X-Accel-Redirect from frappe.
        location ~ ^/protected/(.*) {
            internal;
            try_files /${SITE_NAME}/$1 =404;
        }

        location /socket.io {
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
            # The node server calls back into the site using this origin, so it
            # has to be the externally reachable https URL, not $scheme://$host
            # (inside the container the scheme is plain http).
            proxy_set_header Origin ${SITE_URL};
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_pass http://frappe-socketio;
        }

        location = / {
            ${ROOT_LOCATION}
            try_files /${SITE_NAME}/public/index.html @webserver;
        }

        location / {
            rewrite ^(.+)/$ $1 permanent;
            rewrite ^(.+)/index\.html$ $1 permanent;

            location ~* ^/files/.*\.(htm|html|svg|xml)$ {
                add_header Content-Disposition "attachment";
                try_files /${SITE_NAME}/public/$uri @webserver;
            }

            try_files /${SITE_NAME}/public/$uri @webserver;
        }

        location @webserver {
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
            proxy_set_header X-Use-X-Accel-Redirect True;
            proxy_read_timeout 120s;
            proxy_redirect off;
            proxy_pass http://frappe-backend;
        }
    }
}
